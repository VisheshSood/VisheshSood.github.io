---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = "Innovative Gloves | Premium Latex and Nitrile Glove Manufacturer",
  description = "Thailand's premium manufacturer of latex and nitrile disposable gloves, home of the Diamond, Micro Diamond, Zig and Tyre Tread grip technologies. Engineered for grip where ordinary gloves fall short. SMETA 4-Pillar certified. OEM & private label.",
  image = "/images/sus-aerial.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

// Absolute URLs for canonical / social tags (driven by `site` in astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const siteName = "Innovative Gloves";

// Organisation structured data (helps Google's Knowledge Graph / brand results).
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Innovative Gloves Co., Ltd.",
  alternateName: "Innovative Gloves",
  url: Astro.site?.href,
  logo: new URL("/images/innovative-gloves-logo-blue.png", Astro.site).href,
  description:
    "Family-owned Thai manufacturer of patented textured nitrile and latex gloves, established 2001. Diamond, Micro Diamond, Zig and Tyre Tread grip technologies for automotive, industrial, food, medical and cleaning use.",
  foundingDate: "2001",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Hat Yai",
    addressRegion: "Songkhla",
    addressCountry: "TH",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "sales@innovativeglove.com",
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Innovative Gloves",
  url: Astro.site?.href,
  publisher: { "@type": "Organization", name: "Innovative Gloves Co., Ltd." },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#8cc63f" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp, iMessage link previews) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1366" />
    <meta property="og:image:height" content="768" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Archivo (headings) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
