---
import PageLayout from "../../layouts/PageLayout.astro";
import { technologies } from "../../data/site";
import { catalogue } from "../../data/catalogue";
import GloveVisual from "../../components/GloveVisual.astro";

export function getStaticPaths() {
  return technologies.map((t) => ({ params: { slug: t.slug }, props: { tech: t } }));
}
const { tech } = Astro.props;

const eyebrow = tech.icon === "leaf" ? "Material Innovation" : "Patented Technology";

// Gloves that use this technology (from the real catalogue)
const texByTech: Record<string, string> = {
  "micro-diamond": "Micro Diamond",
  "zig-grip": "Zig",
  "tyre-tread": "Tyre Tread",
  "raised-diamond": "Diamond",
};
const related = catalogue
  .filter((g) => (tech.slug === "biodegradable" ? g.bio : g.texture === texByTech[tech.slug]))
  .slice(0, 4);

// Map best-for labels to industry slugs where possible
const indSlug: Record<string, string> = {
  "Automotive": "automotive",
  "Manufacturing & Engineering": "manufacturing",
  "Oil, Gas & Petrochemical": "oil-gas",
  "Chemical Handling": "chemical",
  "Food Processing": "food-processing",
  "Construction": "construction",
  "Maintenance / MRO": "manufacturing",
  "Cleaning & Janitorial": "cleaning",
  "Laboratory": "laboratory",
  "General Industrial": "general-purpose",
  "General Purpose": "general-purpose",
};
---

<PageLayout title={`${tech.name}, Patented Grip | Innovative Gloves`} description={`${tech.name}: ${tech.tagline} ${tech.intro}`}>
  <!-- HERO -->
  <section class="th-hero">
    <div class="container th-hero-grid">
      <div class="th-copy">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{tech.name}</h1>
        <p class="th-tagline">{tech.tagline}</p>
        <p class="th-intro">{tech.intro}</p>
        <div class="th-cta">
          <a href="/request-samples" class="btn btn--primary">Request a Sample <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a href="#gloves" class="btn btn--ghost">See Gloves</a>
        </div>
        <p class="th-patent"><span aria-hidden="true">◆</span> {tech.patentStatus}</p>
      </div>
      <div class:list={["th-media", tech.imgFit === "contain" && "th-media--contain"]}>
        <div class="th-img" style={`background-image: url('${tech.img}')`}></div>
      </div>
    </div>
  </section>

  <!-- STORY -->
  {tech.story && (
    <section class="th-story">
      <div class="container">
        <p class="eyebrow">The Origin</p>
        <p class="th-story-text">{tech.story}</p>
      </div>
    </section>
  )}

  <!-- DIFFERENCE + BENEFITS -->
  <section class="section th-diff">
    <div class="container">
      <div class="th-diff-head">
        <h2>What Makes It Different<span class="dot">.</span></h2>
        <p class="muted th-diff-lead">{tech.difference}</p>
      </div>
      <ul class="th-benefits">
        {tech.benefits.map((b) => (
          <li class="th-benefit">
            <span class="th-check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12l5 5L20 6"/></svg></span>
            <div>
              <h3>{b.title}</h3>
              <p class="muted">{b.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BEST FOR -->
  <section class="section th-bestfor">
    <div class="container">
      <p class="eyebrow">Best For</p>
      <h2>Where It Performs<span class="dot">.</span></h2>
      <ul class="th-chips">
        {tech.bestFor.map((b) => (
          <li><a href={indSlug[b] ? `/industries/${indSlug[b]}` : "/industries"}>{b}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- GLOVES USING THIS -->
  <section class="section th-gloves" id="gloves">
    <div class="container">
      <header class="th-gloves-head">
        <div>
          <p class="eyebrow">The Range</p>
          <h2>Gloves With {tech.shortName}<span class="dot">.</span></h2>
        </div>
        <a href="/gloves" class="btn btn--ghost">View All Gloves <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </header>

      {related.length > 0 ? (
        <div class="th-glove-grid">
          {related.map((p) => (
            <a class="th-glove-card" href={`/gloves/${p.slug}`}>
              <GloveVisual glove={p} />
              <div class="th-glove-body">
                <h3>{p.name}</h3>
                <span class="th-glove-meta">{p.thickness ? p.thickness + " mil · " : ""}{p.material}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="muted">Browse the full range to find gloves using {tech.shortName}.</p>
      )}
    </div>
  </section>

  {tech.note && (
    <section class="th-note">
      <div class="container"><p>{tech.note}</p></div>
    </section>
  )}

  <!-- CTA -->
  <section class="th-final">
    <div class="container">
      <h2>Feel the Grip<span class="dot">.</span></h2>
      <p>The fastest way to understand {tech.shortName} is to hold it. Request a sample and put it to work.</p>
      <div class="th-final-cta">
        <a href="/request-samples" class="btn btn--primary">Request Samples <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/contact" class="btn btn--ghost">Contact Us</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero */
  .th-hero { background: var(--bg-2); border-bottom: 1px solid var(--border); }
  .th-hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 5vw, 60px); align-items: center; padding-block: clamp(44px, 6vw, 84px); }
  .th-copy h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 12px 0 10px; }
  .th-tagline { font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; color: var(--green-dark); font-size: 1.05rem; margin-bottom: 18px; }
  .th-intro { color: var(--text-muted); font-size: 1.06rem; max-width: 48ch; margin-bottom: 26px; }
  .th-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 22px; }
  .th-patent { font-size: 0.82rem; color: var(--text-muted); }
  .th-patent span { color: var(--green); }

  .th-media { position: relative; }
  .th-img { aspect-ratio: 4 / 3; border-radius: var(--radius); background-size: cover; background-position: center; background-repeat: no-repeat; border: 1px solid var(--border); }
  .th-media--contain .th-img { background-size: contain; background-color: #fff; }

  /* Story */
  .th-story { background: var(--ink); color: #fff; padding-block: clamp(44px, 6vw, 80px); }
  .th-story .eyebrow { color: var(--green); }
  .th-story-text { font-family: var(--font-head); font-weight: 700; text-transform: none; font-size: clamp(1.2rem, 2.4vw, 1.7rem); line-height: 1.4; max-width: 62ch; margin-top: 14px; color: #fff; letter-spacing: 0; }

  /* Difference + benefits */
  .th-diff { background: var(--bg); }
  .th-diff-head { max-width: 720px; margin-bottom: clamp(28px, 4vw, 44px); }
  .th-diff-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .th-diff-lead { margin-top: 14px; font-size: 1.05rem; }
  .th-benefits { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .th-benefit { display: flex; gap: 14px; padding: 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
  .th-check { flex: none; width: 26px; height: 26px; color: var(--green-dark); background: rgba(140,198,63,0.14); border-radius: 50%; display: grid; place-items: center; }
  .th-check svg { width: 15px; height: 15px; }
  .th-benefit h3 { font-size: 1.02rem; margin-bottom: 6px; }
  .th-benefit p { font-size: 0.9rem; }

  /* Best for */
  .th-bestfor { background: var(--bg-2); }
  .th-bestfor h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 10px 0 22px; }
  .th-chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .th-chips a { display: inline-flex; padding: 12px 20px; border: 1px solid var(--border-strong); border-radius: 999px; font-weight: 600; font-size: 0.9rem; color: var(--ink); transition: all 0.15s ease; }
  .th-chips a:hover { background: var(--green); border-color: var(--green); color: #14210a; }

  /* Gloves */
  .th-gloves { background: var(--bg); }
  .th-gloves-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(24px, 4vw, 40px); }
  .th-gloves-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-top: 10px; }
  .th-glove-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .th-glove-card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .th-glove-card:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0,0,0,0.1); }
  .th-glove-img { aspect-ratio: 4 / 3; background: #eef0eb; }
  .th-glove-img--photo { background-color: #fff; background-size: contain; background-position: center; background-repeat: no-repeat; }
  .th-glove-body { padding: 16px; }
  .th-glove-body h3 { font-size: 1rem; margin-bottom: 6px; }
  .th-glove-meta { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; color: var(--green-dark); text-transform: uppercase; }

  /* Note */
  .th-note { background: var(--bg-2); padding-block: 22px; }
  .th-note p { max-width: 820px; margin-inline: auto; text-align: center; font-size: 0.86rem; color: var(--text-muted); font-style: italic; }

  /* Final CTA */
  .th-final { background: radial-gradient(120% 120% at 50% 0%, rgba(140,198,63,0.12), rgba(140,198,63,0) 60%), var(--bg); border-top: 1px solid var(--border); text-align: center; padding-block: clamp(56px, 8vw, 100px); }
  .th-final h2 { font-size: clamp(2rem, 4.5vw, 3rem); margin-bottom: 14px; }
  .th-final p { color: var(--text-muted); font-size: 1.05rem; max-width: 46ch; margin: 0 auto 26px; }
  .th-final-cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; }

  @media (max-width: 820px) {
    .th-hero-grid { grid-template-columns: 1fr; }
    .th-media { order: -1; }
    .th-benefits { grid-template-columns: 1fr; }
  }
</style>
