---
import PageLayout from "../layouts/PageLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import { MAILER_ENDPOINT, TURNSTILE_SITEKEY } from "../data/forms";
---

<PageLayout title="Contact | Innovative Gloves" description="Get in touch with Innovative Gloves. Factory in Hat Yai and head office in Bangkok, Thailand. Email sales@innovativeglove.com for samples, private-label and technical enquiries.">
  <PageBanner eyebrow="Contact" title={`Get in<br>Touch<span class="dot">.</span>`}
    intro="Questions, samples or a private-label enquiry, tell us what you need and our team will get back to you quickly." />

  <section class="section contact">
    <div class="container contact-grid">
      <form class="contact-form js-mailform" id="contactForm" data-endpoint={MAILER_ENDPOINT} data-form="Contact" aria-label="Contact us">
        <div class="row2">
          <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" placeholder="Your name" required /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="you@example.com" required /></div>
        </div>
        <div class="field"><label for="message">How can we help?</label><textarea id="message" name="message" rows="6" placeholder="Tell us what you need…" required></textarea></div>
        <div class="hp" aria-hidden="true"><label>Leave this field empty<input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY}></div>
        <button type="submit" class="btn btn--primary">Send Message <span class="arrow" aria-hidden="true">&rarr;</span></button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite" hidden></p>
      </form>

      <aside class="contact-side">
        <h3>Sales</h3>
        <p><a href="mailto:sales@innovativeglove.com" class="inline-link">sales@innovativeglove.com</a></p>

        <h3>Hat Yai Factory</h3>
        <p class="muted">830 Moo 4 Sanambin-Banklang Road,<br>Hatyai, Songkhla 90110, Thailand</p>
        <p class="muted">Phone: <a href="tel:+6674502251" class="inline-link">+66 74 502 251</a></p>

        <h3>Bangkok Head Office</h3>
        <p class="muted">75/23 Ocean Tower 2, 17th Floor,<br>Sukhumvit Soi 19, Bangkok 10110, Thailand</p>
        <p class="muted">Phone: <a href="tel:+6622586352" class="inline-link">+66 2 258 6352</a></p>

        <h3>Private Label</h3>
        <p class="muted">Building your own brand? See <a href="/private-label" class="inline-link">OEM / Private Label</a>.</p>
      </aside>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const form = document.getElementById("contactForm") as HTMLFormElement | null;
    const statusEl = document.getElementById("formStatus");
    if (form && statusEl) {
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = new URLSearchParams(new FormData(form) as any);
        if (!data.get("cf-turnstile-response")) {
          statusEl.hidden = false;
          statusEl.className = "form-status is-err";
          statusEl.textContent = "Please complete the anti-spam check.";
          return;
        }
        statusEl.hidden = false;
        statusEl.className = "form-status";
        statusEl.textContent = "Sending…";
        if (btn) btn.disabled = true;
        try {
          const res = await fetch(form.dataset.endpoint || "", { method: "POST", body: data });
          const j = await res.json().catch(() => ({}));
          if (res.ok && j.ok) {
            form.reset();
            if ((window as any).turnstile) (window as any).turnstile.reset();
            statusEl.className = "form-status is-ok";
            statusEl.textContent = "Thanks, your message has been sent. We'll be in touch shortly.";
          } else {
            statusEl.className = "form-status is-err";
            statusEl.textContent = j.error || "Something went wrong. Please email sales@innovativeglove.com directly.";
          }
        } catch {
          statusEl.className = "form-status is-err";
          statusEl.textContent = "Could not reach the server. Please email sales@innovativeglove.com directly.";
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    }
  </script>
</PageLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  input, select, textarea {
    font: inherit; font-size: 0.95rem; padding: 12px 14px; border: 1px solid var(--border-strong);
    border-radius: var(--radius); background: #fff; color: var(--ink); width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--green-dark); box-shadow: 0 0 0 3px rgba(140,198,63,0.18); }
  .contact-form .btn { margin-top: 6px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cf-turnstile { margin: 8px 0 4px; }
  .form-status { margin-top: 14px; font-size: 0.9rem; font-weight: 600; }
  .form-status.is-ok { color: var(--green-dark); }
  .form-status.is-err { color: #c0392b; }

  .contact-side h3 { font-size: 1rem; margin-bottom: 6px; }
  .contact-side h3:not(:first-child) { margin-top: 24px; }
  .inline-link { color: var(--green-dark); text-decoration: underline; }

  @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; } .row2 { grid-template-columns: 1fr; } }
</style>
