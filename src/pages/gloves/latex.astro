---
import PageLayout from "../../layouts/PageLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import GloveCard from "../../components/GloveCard.astro";
import { catalogue } from "../../data/catalogue";

const latex = catalogue
  .filter((g) => g.material === "Latex")
  .sort((a, b) => (a.thickness || 0) - (b.thickness || 0));

const cuffs = [...new Set(latex.map((g) => g.length))].sort((a, b) => a - b);
const powderedCount = latex.filter((g) => /corn starch/i.test(g.treatment || "")).length;
const textures = [
  { name: "Smooth", href: "/resources/guides/glove-textures-explained/", text: "Smooth surface with the natural feel of latex." },
  { name: "Fully textured", href: "/resources/guides/glove-textures-explained/", text: "Light texture over the whole glove for a surer hold." },
  { name: "Raised Diamond", href: "/technologies/raised-diamond/", text: "The original diamond texture, on heavy long-cuff latex." },
  { name: "Micro Diamond", href: "/technologies/micro-diamond/", text: "A dense, fine texture on heavy long-cuff latex." },
  { name: "Zig Grip", href: "/technologies/zig-grip/", text: "The Zig texture on heavy long-cuff latex." },
];
const uses = [
  { label: "Cleaning & janitorial", href: "/industries/cleaning/" },
  { label: "Food processing", href: "/industries/food-processing/" },
  { label: "Laboratory", href: "/industries/laboratory/" },
  { label: "General purpose", href: "/industries/general-purpose/" },
];
---

<PageLayout title="Disposable & Heavy-Duty Latex Gloves, Made in Thailand | Innovative Gloves" description={`Our latex glove range, ${latex.length} families including high-risk, heavy-duty and long-cuff options up to 17 mil. Natural rubber comfort and elasticity, made in Thailand.`}>
  <PageBanner eyebrow="Latex" title={`Disposable &amp; Heavy-Duty Latex Gloves<span class="dot">.</span>`}
    intro={`We make disposable latex gloves from natural rubber in our own factory in Hat Yai, Thailand. The range runs from everyday smooth and fully textured gloves with a ${cuffs[0]} mm cuff to heavy long-cuff gloves at ${cuffs.slice(1).join(" and ")} mm for cleaning and wet work. Heavy latex gloves are also made with our raised diamond, Micro Diamond and Zig textures. Latex gives natural stretch, a close fit and a light feel. Most latex gloves are powder-free, and any glove below can be made under your own brand.`} />

  <section class="section lat-range">
    <div class="container">
      <header class="range-head">
        <div>
          <p class="eyebrow">The Range</p>
          <h2>{latex.length} Latex Gloves<span class="dot">.</span></h2>
        </div>
        <a href="/gloves" class="btn btn--ghost">Filter All Gloves <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </header>
      <div class="range-grid">
        {latex.map((g) => (<GloveCard glove={g} />))}
      </div>
    </div>
  </section>

  <section class="section lat-guide">
    <div class="container">
      <p class="eyebrow">Choosing a Latex Glove</p>
      <h2>What to Look At<span class="dot">.</span></h2>

      <div class="guide-grid">
        <div class="guide-block">
          <h3>Thickness</h3>
          <p>Each glove's thickness is listed on its card and product page. Thinner latex keeps the most feel for detailed work. Heavier latex lasts longer in cleaning, washing and handling rough or wet items. <a href="/resources/guides/how-to-choose-glove-thickness/">How to choose a thickness</a>.</p>
        </div>
        <div class="guide-block">
          <h3>Cuff length</h3>
          <p>Everyday gloves are {cuffs[0]} mm. Long-cuff gloves at {cuffs.slice(1).join(" and ")} mm reach further up the forearm to keep water and cleaning solutions out.</p>
        </div>
        <div class="guide-block">
          <h3>Powdered or powder-free</h3>
          <p>Most of our latex gloves are powder-free. {powderedCount} are made powdered, lightly coated inside with USP-grade corn starch for quick donning. Each glove's card shows which it is.</p>
        </div>
        <div class="guide-block">
          <h3>Latex allergy</h3>
          <p>Natural rubber latex contains proteins that some people are allergic to. Where that is a concern, choose a <a href="/gloves/nitrile/">nitrile glove</a> instead. <a href="/resources/guides/nitrile-vs-latex/">Nitrile vs latex</a> explains the differences.</p>
        </div>
      </div>

      <h3 class="tex-h">Textures</h3>
      <div class="tex-grid">
        {textures.map((t) => (
          <a class="tex-card" href={t.href}>
            <b>{t.name}</b>
            <span>{t.text}</span>
          </a>
        ))}
      </div>

      <div class="guide-grid two">
        <div class="guide-block">
          <h3>Where they are used</h3>
          <ul class="use-list">
            {uses.map((u) => (<li><a href={u.href}>{u.label}</a></li>))}
          </ul>
          <p class="muted small">Not sure which glove fits the job? Use the <a href="/glove-finder/">glove finder</a> or see our <a href="/gloves/heavy-duty/">heavy-duty gloves</a>.</p>
        </div>
        <div class="guide-block">
          <h3>Your brand, our factory</h3>
          <p>Any latex glove on this page can be produced under your own brand, with your choice of colour, packaging and artwork. <a href="/private-label/">OEM and private-label manufacturing</a>.</p>
          <div class="cta-row">
            <a href="/request-quote/" class="btn btn--primary">Request a Quote <span class="arrow" aria-hidden="true">&rarr;</span></a>
            <a href="/request-samples/" class="btn btn--ghost">Request Samples</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section lat-about">
    <div class="container lat-grid">
      <div class="lat-img" style="background-image:url('/images/glovecatalog/gc-latex-blue-long.png')"></div>
      <div class="lat-copy">
        <p class="eyebrow">Why Latex</p>
        <h2>Comfort &amp; Elasticity<span class="dot">.</span></h2>
        <p class="muted">Latex flexes and fits like a second skin, giving exceptional tactile sensitivity and a secure, comfortable grip over long shifts. For heavy-duty and high-risk handling, our thicker latex gloves offer serious protection at a competitive price, produced in-house with strict quality control.</p>
        <ul class="lat-points">
          <li><span class="c" aria-hidden="true">&#10003;</span> Superb elasticity, fit and comfort</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> High-risk &amp; heavy-duty options up to 17 mil</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> Long-cuff (300 mm) protection</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> Powder-free options available</li>
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .lat-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .lat-copy h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 10px 0 16px; }
  .lat-points { margin-top: 20px; display: grid; gap: 10px; }
  .lat-points li { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; }
  .lat-points .c { color: var(--green-dark); font-weight: 900; }
  .lat-img { aspect-ratio: 4 / 3; border-radius: var(--radius); border: 1px solid var(--border); background-color: #fff; background-size: contain; background-position: center; background-repeat: no-repeat; }

  .range-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 40px); }
  .range-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-top: 10px; }
  .range-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }

  .lat-guide { background: var(--bg-2); border-top: 1px solid var(--border); }
  .lat-guide > .container > h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 10px 0 28px; }
  .guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 36px; }
  .guide-grid.two { margin-top: 34px; }
  .guide-block h3, .tex-h { font-size: 1.05rem; margin-bottom: 8px; }
  .guide-block p { line-height: 1.65; }
  .guide-block p a { color: var(--green-dark); font-weight: 600; }
  .tex-h { margin-top: 34px; }
  .tex-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 12px; }
  .tex-card { display: grid; align-content: start; gap: 4px; padding: 16px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); transition: border-color .2s ease, transform .2s ease; }
  .tex-card:hover { border-color: var(--green); transform: translateY(-2px); }
  .tex-card b { font-size: 0.98rem; }
  .tex-card span { font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; }
  .use-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 18px; margin-bottom: 12px; }
  .use-list a { color: var(--green-dark); font-weight: 600; }
  .small { font-size: 0.9rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; }
  @media (max-width: 820px) { .lat-grid, .guide-grid { grid-template-columns: 1fr; } .lat-img { order: -1; } }
</style>
