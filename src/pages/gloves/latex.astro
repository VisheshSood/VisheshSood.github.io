---
import PageLayout from "../../layouts/PageLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import GloveCard from "../../components/GloveCard.astro";
import { catalogue } from "../../data/catalogue";

const latex = catalogue
  .filter((g) => g.material === "Latex")
  .sort((a, b) => (a.thickness || 0) - (b.thickness || 0));
---

<PageLayout title="Latex Gloves | Innovative Gloves" description={`Our latex glove range, ${latex.length} families including high-risk, heavy-duty and long-cuff options up to 14 mil. Natural rubber comfort and elasticity, made in Thailand.`}>
  <PageBanner eyebrow="Latex" title={`Latex Gloves<span class="dot">.</span>`}
    intro="Natural rubber latex delivers outstanding elasticity, comfort and grip, ideal for high-risk and heavy-duty work. Our latex range runs right up to a rugged 14 mil with long-cuff protection." />

  <section class="section lat-about">
    <div class="container lat-grid">
      <div class="lat-img" style="background-image:url('/images/glovecatalog/gc-latex-blue-long.jpg')"></div>
      <div class="lat-copy">
        <p class="eyebrow">Why Latex</p>
        <h2>Comfort &amp; Elasticity<span class="dot">.</span></h2>
        <p class="muted">Latex flexes and fits like a second skin, giving exceptional tactile sensitivity and a secure, comfortable grip over long shifts. For heavy-duty and high-risk handling, our thicker latex gloves offer serious protection at a competitive price, produced in-house with strict quality control.</p>
        <ul class="lat-points">
          <li><span class="c" aria-hidden="true">&#10003;</span> Superb elasticity, fit and comfort</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> High-risk &amp; heavy-duty options up to 14 mil</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> Long-cuff (300 mm) protection</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> Powder-free &amp; double-chlorinated available</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section lat-range">
    <div class="container">
      <header class="range-head">
        <div>
          <p class="eyebrow">The Range</p>
          <h2>{latex.length} Latex Gloves<span class="dot">.</span></h2>
        </div>
        <a href="/gloves" class="btn btn--ghost">Filter All Gloves <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </header>
      <div class="range-grid">
        {latex.map((g) => (<GloveCard glove={g} />))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .lat-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .lat-copy h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 10px 0 16px; }
  .lat-points { margin-top: 20px; display: grid; gap: 10px; }
  .lat-points li { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; }
  .lat-points .c { color: var(--green-dark); font-weight: 900; }
  .lat-img { aspect-ratio: 4 / 3; border-radius: var(--radius); border: 1px solid var(--border); background-color: #fff; background-size: contain; background-position: center; background-repeat: no-repeat; }

  .range-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 40px); }
  .range-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-top: 10px; }
  .range-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }
  @media (max-width: 820px) { .lat-grid { grid-template-columns: 1fr; } .lat-img { order: -1; } }
</style>
