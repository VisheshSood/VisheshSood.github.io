---
import PageLayout from "../../layouts/PageLayout.astro";
import PageBanner from "../../components/PageBanner.astro";
import GloveCard from "../../components/GloveCard.astro";
import { catalogue } from "../../data/catalogue";

const nitrile = catalogue
  .filter((g) => g.material.includes("Nitrile"))
  .sort((a, b) => (a.thickness || 0) - (b.thickness || 0));
---

<PageLayout title="Nitrile Gloves | Innovative Gloves" description={`Our full nitrile glove range, ${nitrile.length} families across textures, thicknesses and colours. Powder-free, polymer-coated, patented grip options and biodegradable nitrile.`}>
  <PageBanner eyebrow="Nitrile" title={`Nitrile Gloves<span class="dot">.</span>`}
    intro="Strong, chemical-resistant and latex-free, nitrile is the backbone of our range. From everyday disposables to patented heavy-duty grip, all made in our own facility in Thailand." />

  <section class="section nit-about">
    <div class="container nit-grid">
      <div class="nit-copy">
        <p class="eyebrow">Why Nitrile</p>
        <h2>Engineered for Performance<span class="dot">.</span></h2>
        <p class="muted">Nitrile offers excellent puncture, abrasion and chemical resistance with no latex-protein allergy risk, which is why it's the material of choice across automotive, industrial, food and medical work. We control the full process, from compound to finished glove, so quality and consistency stay in our hands.</p>
        <ul class="nit-points">
          <li><span class="c" aria-hidden="true">&#10003;</span> Powder-free &amp; polymer-coated options</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> Patented grip textures (Micro Diamond, Zig, Gripper)</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> 3–9 mil, 240–300 mm, 20+ colours</li>
          <li><span class="c" aria-hidden="true">&#10003;</span> Biodegradable nitrile available</li>
        </ul>
      </div>
      <div class="nit-img" style="background-image:url('/images/glovecatalog/gc-diamond-black.jpg')"></div>
    </div>
  </section>

  <section class="section nit-range">
    <div class="container">
      <header class="range-head">
        <div>
          <p class="eyebrow">The Range</p>
          <h2>{nitrile.length} Nitrile Gloves<span class="dot">.</span></h2>
        </div>
        <a href="/gloves" class="btn btn--ghost">Filter All Gloves <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </header>
      <div class="range-grid">
        {nitrile.map((g) => (<GloveCard glove={g} />))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .nit-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .nit-copy h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin: 10px 0 16px; }
  .nit-points { margin-top: 20px; display: grid; gap: 10px; }
  .nit-points li { display: flex; align-items: center; gap: 10px; font-weight: 500; font-size: 0.95rem; }
  .nit-points .c { color: var(--green-dark); font-weight: 900; }
  .nit-img { aspect-ratio: 4 / 3; border-radius: var(--radius); border: 1px solid var(--border); background-color: #fff; background-size: contain; background-position: center; background-repeat: no-repeat; }

  .range-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 40px); }
  .range-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-top: 10px; }
  .range-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }
  @media (max-width: 820px) { .nit-grid { grid-template-columns: 1fr; } .nit-img { order: -1; } }
</style>
