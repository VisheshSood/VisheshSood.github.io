---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import IntroStats from "../components/IntroStats.astro";
import Technologies from "../components/Technologies.astro";
import Industries from "../components/Industries.astro";
import FlagshipProducts from "../components/FlagshipProducts.astro";
import ReviewsCarousel from "../components/ReviewsCarousel.astro";
import Manufacturing from "../components/Manufacturing.astro";
import SustainabilityHome from "../components/SustainabilityHome.astro";
import Certifications from "../components/Certifications.astro";
import HistoryPreview from "../components/HistoryPreview.astro";
import OemPreview from "../components/OemPreview.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Nitrile & Latex Glove Manufacturer in Thailand | Innovative Gloves"
  description="Thailand manufacturer of disposable nitrile and latex gloves since 2001. Industrial, food-handling, OEM and private-label glove manufacturing."
>
  <Header />
  <main>
    <Hero />
    <TrustBar />
    <IntroStats />
    <Technologies />
    <Industries />
    <FlagshipProducts />
    <ReviewsCarousel />
    <Manufacturing />
    <SustainabilityHome />
    <HistoryPreview />
    <Certifications />
    <OemPreview />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
