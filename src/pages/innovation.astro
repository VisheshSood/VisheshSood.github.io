---
import PageLayout from "../layouts/PageLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import SectionStub from "../components/SectionStub.astro";
---

<PageLayout title="Innovation & R&D | Innovative Gloves" description="How Innovative Gloves develops new textures, colours and materials, from prototype to production. We create products rather than copy market gloves.">
  <PageBanner eyebrow="Innovation / R&D" title={`We Create Gloves.<br>We Don't Copy Them<span class="dot">.</span>`}
    intro="How new glove concepts move from idea to production, the process behind our grip textures and materials." />

  <SectionStub tone="light" eyebrow="How We Develop" title="From Prototype to Production" lead="A structured, customer-driven development process." layout="checklist"
    items={["Texture development", "Colour development", "Material experimentation", "Testing", "Customer-driven product development", "Patents", "Prototype-to-production process"]} />
</PageLayout>
