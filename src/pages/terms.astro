<style>
  .legal { max-width: 760px; }
  .legal-updated { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 28px; }
  .legal h2 { font-size: 1.15rem; margin: 30px 0 10px; }
  .legal p { font-size: 1rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .inline-link { color: var(--green-dark); text-decoration: underline; }
</style>
