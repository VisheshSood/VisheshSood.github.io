---
// Welcome promo popup (editorial light theme): captures an email and notifies
// the team that someone is interested in the "50% Off Selected Gloves"
// promotion. Shown once per session.
import { MAILER_ENDPOINT } from "../data/forms";
---

<div class="promo" id="promoPopup" role="dialog" aria-modal="true" aria-labelledby="promoTitle" hidden>
  <div class="promo-backdrop" data-close></div>
  <div class="promo-card">
    <img class="promo-ghost" src="/images/promo/gloves-lineup.png" alt="" aria-hidden="true" />

    <div class="promo-top">
      <p class="promo-eyebrow">Limited-Time Offer</p>
      <button type="button" class="promo-x" data-close aria-label="Close">&times;</button>
    </div>

    <div class="promo-content" id="promoBody">
      <div id="promoOffer">
        <div class="promo-head">
          <div class="promo-frame">
            <span class="cm cm-tl"></span><span class="cm cm-tr"></span><span class="cm cm-bl"></span><span class="cm cm-br"></span>
            <span class="promo-bignum">&minus;50<i>%</i></span>
          </div>
          <h2 class="promo-title" id="promoTitle">50% Off Selected Gloves<span class="dot">.</span></h2>
        </div>

        <p class="promo-sub">Enter your email and we will send you the deal on our high quality products on sale before they are gone.</p>

        <form class="promo-form" id="promoForm" novalidate>
          <input type="text" name="company_website" class="promo-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="sr-only" for="promoEmail">Email address</label>
          <input type="email" id="promoEmail" name="email" class="promo-input" placeholder="your@email.com" required autocomplete="email" />
          <div class="promo-btnwrap">
            <span class="cm cm-tl"></span><span class="cm cm-tr"></span><span class="cm cm-bl"></span><span class="cm cm-br"></span>
            <button type="submit" class="promo-submit">Get My 50% Off <span aria-hidden="true">&rarr;</span></button>
          </div>
        </form>
        <p class="promo-status" id="promoStatus" role="status" aria-live="polite"></p>
        <p class="promo-fine">No spam. We will only email you about this promotion.</p>
      </div>

      <div class="promo-thanks" id="promoThanks" hidden>
        <div class="promo-tick" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l5 5L20 6" /></svg>
        </div>
        <h2>You're In<span class="dot">.</span></h2>
        <p>Thanks. Our team will email you the 50% off details shortly, keep an eye on your inbox.</p>
        <button type="button" class="promo-submit promo-done" data-close>Done</button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ endpoint: MAILER_ENDPOINT }}>
  (function () {
    const SEEN = "ig_promo_seen", DONE = "ig_promo_done";
    const el = document.getElementById("promoPopup");
    if (!el) return;
    let signedUp = false, seen = false;
    try { signedUp = localStorage.getItem(DONE) === "1"; } catch (e) {}
    try { seen = sessionStorage.getItem(SEEN) === "1"; } catch (e) {}
    // /?promo (or #promo) always re-opens it; /#thanks previews the success screen.
    const previewThanks = location.hash === "#thanks";
    const force = /[?&]promo\b/.test(location.search) || location.hash === "#promo" || previewThanks;
    if (signedUp && !force) return; // already signed up, never nag again

    const lock = (on) => { document.body.style.overflow = on ? "hidden" : ""; };
    // Once per browsing SESSION: repeat visitors see it again next visit,
    // but it won't re-trigger on every page/refresh within one visit.
    const open = () => { el.hidden = false; lock(true); try { sessionStorage.setItem(SEEN, "1"); } catch (e) {} };
    const close = () => { el.hidden = true; lock(false); };

    if (force) { open(); }
    else if (!seen) { setTimeout(open, 1200); }

    // Preview the success screen (no email sent, no flag stored) via /#thanks.
    if (previewThanks) {
      const offer = document.getElementById("promoOffer");
      const thanks = document.getElementById("promoThanks");
      if (offer) offer.hidden = true;
      if (thanks) thanks.hidden = false;
    }

    el.querySelectorAll("[data-close]").forEach((b) => b.addEventListener("click", close));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !el.hidden) close(); });

    const form = document.getElementById("promoForm");
    const status = document.getElementById("promoStatus");
    const emailOk = (v) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);

    const done = () => {
      try { localStorage.setItem(DONE, "1"); } catch (e) {}
      const offer = document.getElementById("promoOffer");
      const thanks = document.getElementById("promoThanks");
      if (offer) offer.hidden = true;
      if (thanks) thanks.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = form.email.value.trim();
      if (!emailOk(email)) { status.textContent = "Please enter a valid email address."; status.dataset.state = "err"; return; }
      if (form.company_website.value) { done(); return; }

      const btn = form.querySelector(".promo-submit");
      btn.disabled = true;
      status.dataset.state = "";
      status.textContent = "Sending...";
      try {
        const fd = new FormData();
        fd.append("form", "Promo");
        fd.append("email", email);
        fd.append("company_website", "");
        const res = await fetch(endpoint, { method: "POST", body: fd });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { done(); }
        else { status.textContent = data.error || "Something went wrong. Please try again."; status.dataset.state = "err"; btn.disabled = false; }
      } catch (err) {
        status.textContent = "Network error. Please try again."; status.dataset.state = "err"; btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .promo { position: fixed; inset: 0; z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .promo[hidden] { display: none; }
  .promo-backdrop { position: absolute; inset: 0; background: rgba(8, 10, 7, 0.6); backdrop-filter: blur(3px); animation: promo-fade 0.25s ease; }
  .promo-card {
    position: relative; z-index: 1; width: min(640px, 100%); overflow: hidden;
    background: var(--surface, #fff); border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4); animation: promo-pop 0.3s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  @keyframes promo-fade { from { opacity: 0; } }
  @keyframes promo-pop { from { opacity: 0; transform: translateY(14px) scale(0.98); } }

  /* Ghosted glove watermark behind the content */
  .promo-ghost {
    position: absolute; left: 50%; bottom: -6%; transform: translateX(-50%);
    width: 108%; max-width: none; z-index: 0; pointer-events: none;
    filter: grayscale(1) brightness(1.35) contrast(0.9); opacity: 0.1;
  }

  .promo-top {
    position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between;
    padding: 18px clamp(22px, 4vw, 34px); border-bottom: 1px solid var(--border, #e6e9e1);
  }
  .promo-eyebrow { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--green-dark, #5a8f1e); }
  .promo-x {
    width: 34px; height: 34px; border: 0; background: none; color: var(--ink, #14180f);
    font-size: 1.6rem; line-height: 1; cursor: pointer; border-radius: 50%; transition: background 0.15s;
  }
  .promo-x:hover { background: rgba(0, 0, 0, 0.06); }

  .promo-content { position: relative; z-index: 2; padding: clamp(24px, 4vw, 40px); }

  .promo-head { display: flex; align-items: center; gap: clamp(20px, 4vw, 40px); margin-bottom: 22px; }

  /* Framed big number with corner registration marks */
  .promo-frame { position: relative; flex: none; padding: 18px 26px; border: 1px solid var(--border, #e0e4da); }
  .promo-bignum { font-family: var(--font-head, sans-serif); font-weight: 900; font-size: clamp(2.6rem, 7vw, 4.4rem); line-height: 0.9; color: var(--green, #8CC63F); letter-spacing: -0.02em; }
  .promo-bignum i { font-style: normal; font-size: 0.55em; vertical-align: super; }

  .cm { position: absolute; width: 12px; height: 12px; z-index: 3; }
  .cm::before, .cm::after { content: ""; position: absolute; background: var(--ink, #14180f); }
  .cm::before { left: 0; right: 0; top: 50%; height: 1.5px; transform: translateY(-50%); }
  .cm::after { top: 0; bottom: 0; left: 50%; width: 1.5px; transform: translateX(-50%); }
  .cm-tl { top: -6px; left: -6px; } .cm-tr { top: -6px; right: -6px; }
  .cm-bl { bottom: -6px; left: -6px; } .cm-br { bottom: -6px; right: -6px; }

  .promo-title { font-family: var(--font-head, sans-serif); font-weight: 900; text-transform: uppercase; font-size: clamp(1.7rem, 4.2vw, 2.6rem); line-height: 0.98; color: var(--ink, #14180f); }
  .promo-title .dot { color: var(--green, #8CC63F); }

  .promo-sub { color: var(--text-muted, #55605a); font-size: 0.95rem; line-height: 1.5; max-width: 52ch; margin-bottom: 22px; }

  .promo-form { display: flex; gap: 14px; align-items: stretch; flex-wrap: wrap; }
  .promo-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .promo-input {
    flex: 1 1 240px; min-width: 0; padding: 15px 16px; border: 1px solid var(--border-strong, #cfd6c8); border-radius: 0;
    font-size: 0.98rem; font-family: inherit; background: rgba(255, 255, 255, 0.85); color: var(--ink, #14180f);
  }
  .promo-input:focus { outline: 0; border-color: var(--green, #8CC63F); box-shadow: 0 0 0 3px rgba(140, 198, 63, 0.25); }

  .promo-btnwrap { position: relative; flex: 0 0 auto; }
  .promo-submit {
    height: 100%; padding: 15px 26px; border: 0; cursor: pointer; white-space: nowrap;
    background: var(--green, #8CC63F); color: #14210a; font-family: var(--font-head, sans-serif);
    font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.92rem;
    transition: background 0.15s;
  }
  .promo-submit:hover { background: var(--green-dark, #7ab52f); }
  .promo-submit:disabled { opacity: 0.6; cursor: default; }

  .promo-status { position: relative; z-index: 2; font-size: 0.85rem; margin: 12px 0 0; }
  .promo-status:empty { display: none; }
  .promo-status[data-state="err"] { color: #c0392b; }
  .promo-fine { position: relative; z-index: 2; font-size: 0.72rem; color: var(--text-muted, #7c857c); margin: 10px 0 0; }

  /* Success screen */
  .promo-thanks { text-align: center; padding: 12px 0 6px; }
  .promo-tick { width: 60px; height: 60px; margin: 0 auto 16px; border-radius: 50%; background: var(--green, #8CC63F); color: #14210a; display: grid; place-items: center; box-shadow: 0 6px 18px rgba(140, 198, 63, 0.45); animation: promo-tick-pop 0.35s cubic-bezier(0.2, 0.8, 0.3, 1) both; }
  .promo-tick svg { width: 30px; height: 30px; }
  @keyframes promo-tick-pop { from { transform: scale(0); opacity: 0; } }
  .promo-thanks h2 { font-family: var(--font-head, sans-serif); font-weight: 900; text-transform: uppercase; font-size: clamp(1.6rem, 4vw, 2.1rem); margin-bottom: 8px; color: var(--ink, #14180f); }
  .promo-thanks .dot { color: var(--green, #8CC63F); }
  .promo-thanks p { color: var(--text-muted, #55605a); font-size: 0.92rem; line-height: 1.5; max-width: 42ch; margin: 0 auto 20px; }
  .promo-done { width: auto; height: auto; display: inline-block; padding: 13px 34px; }

  @media (max-width: 560px) {
    .promo-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .promo-frame { align-self: flex-start; }
    .promo-submit { width: 100%; }
    .promo-btnwrap { flex: 1 1 100%; }
    .promo-done { width: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .promo-backdrop, .promo-card { animation: none; } .promo-tick { animation: none; } }
</style>
