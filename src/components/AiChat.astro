---
// AI chat assistant (answers from the public knowledge base only; see erp-bot/webchat on the server).
// If the chat service is not reachable, this widget stays hidden and tawk.to shows as before.
// "Talk to a person" hands over to tawk.to.
---
<div class="aic" id="aiChat" hidden>
  <button type="button" class="aic-fab" id="aicOpen" aria-expanded="false" aria-controls="aicPanel">
    <span class="aic-fab-dot" aria-hidden="true"></span> Ask us anything
  </button>

  <section class="aic-panel" id="aicPanel" role="dialog" aria-label="Chat with Innovative Gloves" hidden>
    <header class="aic-head">
      <div>
        <p class="aic-eyebrow">Innovative Gloves</p>
        <h2 class="aic-title">How can we help<span class="dot">?</span></h2>
      </div>
      <button type="button" class="aic-x" id="aicClose" aria-label="Close chat">&times;</button>
    </header>

    <div class="aic-log" id="aicLog" aria-live="polite">
      <div class="aic-msg aic-bot">Hi! I can answer questions about our gloves, grip textures, certifications, samples and private label. For prices, I'll pass your enquiry to our sales team.</div>
      <div class="aic-chips" id="aicChips">
        <button type="button">Which glove is best for oily work?</button>
        <button type="button">Are your gloves food safe?</button>
        <button type="button">Can you make our own brand?</button>
        <button type="button">How do I get samples?</button>
      </div>
    </div>

    <form class="aic-form" id="aicForm" autocomplete="off">
      <label class="sr-only" for="aicInput">Your message</label>
      <textarea id="aicInput" rows="1" maxlength="800" placeholder="Type your question…" required></textarea>
      <button type="submit" class="aic-send" aria-label="Send">&rarr;</button>
    </form>
    <div class="aic-foot">
      <button type="button" class="aic-human" id="aicHuman">Talk to a person</button>
      <span class="aic-note">Automated assistant · <a href="/privacy">Privacy</a></span>
    </div>
  </section>
</div>

<style is:global>
  /* Global on purpose: messages are created by the script, and Astro's scoped CSS would not reach them. All classes are aic- prefixed. */
  .aic[hidden], .aic-panel[hidden], .aic-fab[hidden] { display: none !important; }
  .aic { position: fixed; right: 20px; bottom: 20px; z-index: 900; font-family: var(--font-body); }
  .aic-fab {
    display: inline-flex; align-items: center; gap: 10px; padding: 14px 20px; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--ink); color: #fff; font: 600 15px/1 var(--font-body); box-shadow: 0 10px 30px rgba(0,0,0,.22);
    transition: transform .15s ease, background .15s ease;
  }
  .aic-fab:hover { background: #000; transform: translateY(-2px); }
  .aic-fab-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgba(140,198,63,.25); }
  .aic-panel {
    position: absolute; right: 0; bottom: 0; width: min(390px, calc(100vw - 32px)); height: min(600px, calc(100vh - 40px));
    height: min(600px, calc(100dvh - 40px));
    display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; box-shadow: 0 24px 60px rgba(0,0,0,.25); overflow: hidden;
    animation: aic-in .18s ease-out;
  }
  @keyframes aic-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .aic-head { display: flex; justify-content: space-between; align-items: flex-start; padding: 16px 16px 14px 18px; background: var(--ink); color: #fff; flex: none; }
  .aic-eyebrow { margin: 0 0 4px; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--green); }
  .aic-title { margin: 0; font: 800 21px/1.1 var(--font-head); text-transform: uppercase; letter-spacing: .01em; color: #fff; text-align: left; }
  .aic-title .dot { color: var(--green); }
  .aic-x { background: none; border: 0; color: #fff; font-size: 28px; line-height: 1; cursor: pointer; padding: 0 4px; opacity: .85; }
  .aic-x:hover { opacity: 1; }
  .aic-log { flex: 1; min-height: 0; overflow-y: auto; padding: 16px 14px; display: flex; flex-direction: column; gap: 10px; background: var(--bg-2); overscroll-behavior: contain; }
  .aic-msg { max-width: 85%; padding: 10px 13px; border-radius: 14px; font-size: 14.5px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
  .aic-bot { align-self: flex-start; background: var(--surface); border: 1px solid var(--light-border); color: var(--text); border-bottom-left-radius: 4px; }
  .aic-me { align-self: flex-end; background: var(--ink); color: #fff; border-bottom-right-radius: 4px; }
  .aic-bot a { color: var(--green-dark); text-decoration: underline; text-underline-offset: 2px; }
  .aic-me a { color: var(--green); }
  .aic-typing { display: inline-flex; gap: 4px; padding: 13px 14px; }
  .aic-typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--text-dim); opacity: .4; animation: aic-dot 1.2s infinite; }
  .aic-typing i:nth-child(2) { animation-delay: .15s; } .aic-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes aic-dot { 0%, 60%, 100% { opacity: .35; transform: none; } 30% { opacity: 1; transform: translateY(-3px); } }
  .aic-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
  .aic-chips[hidden] { display: none; }
  .aic-chips button {
    border: 1px solid var(--green-dark); background: var(--surface); color: var(--green-dark); border-radius: 999px;
    padding: 6px 11px; font: 500 13px/1.2 var(--font-body); cursor: pointer; text-align: left;
  }
  .aic-chips button:hover { background: var(--green); border-color: var(--green); color: var(--ink); }
  .aic-form { display: flex; align-items: flex-end; gap: 8px; padding: 12px 12px 10px; border-top: 1px solid var(--border); background: var(--surface); flex: none; }
  .aic-form textarea {
    flex: 1; resize: none; min-height: 44px; max-height: 110px; padding: 11px 12px; border: 1px solid var(--border-strong); border-radius: 10px;
    font: 15px/1.4 var(--font-body); color: var(--text); background: var(--bg); box-sizing: border-box;
  }
  .aic-form textarea:focus { outline: 2px solid var(--green); outline-offset: -1px; border-color: transparent; }
  .aic-send { flex: none; width: 44px; height: 44px; border: 0; border-radius: 10px; background: var(--green); color: var(--ink); font-size: 20px; font-weight: 700; cursor: pointer; }
  .aic-send:hover:not(:disabled) { background: var(--green-bright); }
  .aic-send:disabled { opacity: .45; cursor: default; }
  .aic-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 0 12px 12px; background: var(--surface); flex: none; }
  .aic-human { background: none; border: 1px solid var(--border-strong); border-radius: 999px; padding: 6px 12px; font: 600 13px var(--font-body); color: var(--text); cursor: pointer; }
  .aic-human:hover { border-color: var(--green-dark); color: var(--green-dark); }
  .aic-note { font-size: 12px; color: var(--text-dim); }
  .aic-note a { color: inherit; }
  @media (max-width: 480px) {
    .aic { right: 12px; bottom: 12px; }
    .aic-fab { padding: 12px 16px; font-size: 14px; }
    .aic-panel { position: fixed; inset: 0; width: auto; height: auto; border-radius: 0; border: 0; }
    .aic-form textarea { font-size: 16px; } /* stops iOS zooming into the box */
  }
  @media (prefers-reduced-motion: reduce) { .aic-panel, .aic-typing i, .aic-fab { animation: none; transition: none; } }
</style>

<script is:inline>
  (function () {
    var API = "/api/chat";
    var root = document.getElementById("aiChat");
    if (!root) return;
    var panel = document.getElementById("aicPanel"), openBtn = document.getElementById("aicOpen"), log = document.getElementById("aicLog");
    var form = document.getElementById("aicForm"), input = document.getElementById("aicInput"), sendBtn = form.querySelector(".aic-send");
    var chips = document.getElementById("aicChips");
    var GAP_MS = 10500;   // the server allows one question per 10 s; pace sends so real visitors never see "please wait"
    var lastSent = 0, busy = false;

    function store(k, v) { try { if (v === undefined) return sessionStorage.getItem(k); sessionStorage.setItem(k, v); } catch (e) { return null; } }
    var session = store("aic_session");
    if (!session) {
      session = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2);
      store("aic_session", session);
    }

    // Only show the AI chat if its service answers; tawk.to stays as the fallback.
    fetch(API + "/health").then(function (r) { if (!r.ok) throw 0; return r.json(); }).then(function () {
      window.__aiChatReady = true;
      root.hidden = false;
      hideTawk();
      restore();
    }).catch(function () { /* service down: leave tawk.to alone */ });

    // tawk.to may load before or after this check: hide it now if it is up, and again whenever it finishes loading
    function hideTawk() {
      var T = window.Tawk_API = window.Tawk_API || {};
      var prev = T.onLoad;
      T.onLoad = function () { if (prev) { try { prev(); } catch (e) {} } if (window.__aiChatReady && !window.__aiHuman) { T.hideWidget(); } };
      try { if (T.hideWidget) { T.hideWidget(); } } catch (e) {}
    }

    function addMsg(text, who) {
      var d = document.createElement("div");
      d.className = "aic-msg " + (who === "me" ? "aic-me" : "aic-bot");
      if (who !== "me") { text = text.replace(/\*\*(.+?)\*\*/g, "$1").replace(/^#+\s*/gm, ""); }   // stray markdown
      // text only - URLs become links, nothing else is interpreted as HTML
      text.split(/(https?:\/\/[^\s)]+)/g).forEach(function (part) {
        if (/^https?:\/\//.test(part)) {
          var a = document.createElement("a"); a.href = part; a.textContent = part.replace(/^https?:\/\/(www\.)?/, "");
          a.target = part.indexOf(location.host) === -1 ? "_blank" : "_self"; a.rel = "noopener"; d.appendChild(a);
        } else { d.appendChild(document.createTextNode(part)); }
      });
      log.appendChild(d); log.scrollTop = log.scrollHeight;
      return d;
    }
    function remember(text, who) {
      var h = []; try { h = JSON.parse(store("aic_history") || "[]"); } catch (e) {}
      h.push([who, text]); store("aic_history", JSON.stringify(h.slice(-30)));
    }
    function restore() {
      var h = []; try { h = JSON.parse(store("aic_history") || "[]"); } catch (e) {}
      h.forEach(function (m) { addMsg(m[1], m[0]); });
      if (h.length) { chips.hidden = true; }
    }
    function typing() {
      var d = document.createElement("div"); d.className = "aic-msg aic-bot aic-typing"; d.setAttribute("aria-label", "Typing");
      d.innerHTML = "<i></i><i></i><i></i>"; log.appendChild(d); log.scrollTop = log.scrollHeight; return d;
    }
    chips.addEventListener("click", function (e) {
      var b = e.target.closest("button"); if (!b || busy) return;
      input.value = b.textContent; form.requestSubmit();
    });

    function setOpen(open) {
      panel.hidden = !open; openBtn.hidden = open; openBtn.setAttribute("aria-expanded", String(open));
      if (open) { setTimeout(function () { input.focus(); }, 50); log.scrollTop = log.scrollHeight; }
    }
    openBtn.addEventListener("click", function () { setOpen(true); });
    document.getElementById("aicClose").addEventListener("click", function () { setOpen(false); });
    document.getElementById("aicHuman").addEventListener("click", function () {
      setOpen(false); root.hidden = true; window.__aiHuman = true;
      if (window.Tawk_API && Tawk_API.showWidget) { try { Tawk_API.showWidget(); Tawk_API.maximize(); } catch (e) {} }
      else { location.href = "/contact"; }
    });
    input.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
    input.addEventListener("input", function () { input.style.height = "auto"; input.style.height = Math.min(input.scrollHeight, 110) + "px"; });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var text = input.value.trim();
      if (!text || busy) return;
      busy = true; sendBtn.disabled = true; chips.hidden = true;
      input.value = ""; input.style.height = "auto";
      addMsg(text, "me"); remember(text, "me");
      var wait = typing();
      var delay = Math.max(0, lastSent + GAP_MS - Date.now());
      setTimeout(function () {
        lastSent = Date.now();
        fetch(API, { method: "POST", headers: { "Content-Type": "application/json" },
                     body: JSON.stringify({ session: session, message: text, page: location.pathname }) })
          .then(function (r) { return r.json(); })
          .then(function (d) { wait.remove(); var t = d.reply || "Sorry, something went wrong. Please email sales@innovativeglove.com."; addMsg(t, "bot"); remember(t, "bot"); })
          .catch(function () { wait.remove(); addMsg("Sorry, the chat is unavailable right now. Please email sales@innovativeglove.com or press Talk to a person.", "bot"); })
          .finally(function () { busy = false; sendBtn.disabled = false; input.focus(); });
      }, delay);
    });
  })();
</script>
