---
import { mainNav as nav } from "../data/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Innovative Gloves, home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="35 0 58 64"
     xmlns="http://www.w3.org/2000/svg"
     fill="currentColor"
     data-astro-cid-nen7h5rs="">

  <g transform="translate(64 32) scale(0.7 1) translate(-64 -32)">

    <path d="M46.7,3.6L46.7,3.6c-0.4,0-0.6,0.2-0.6,0.4v0.6v0.1v2.2c-0.4-0.2-0.9-0.3-0.9-0.3V3V3V2.4c0-0.2-0.2-0.4-0.5-0.4h-0.1C44.2,2,44,2.2,44,2.4V3V3v3.1C43.7,6.1,43.4,6,43,6V2.2V2.1V1.6c0-0.2-0.2-0.4-0.5-0.4h-0.1c-0.3,0-0.5,0.2-0.5,0.4v0.6v0.1v3.9c0,0,0,0,0,0c-0.3,0-0.6,0.1-0.8,0.2c0,0,0,0,0,0V3.4V3.3V2.7c0-0.2-0.2-0.4-0.5-0.4h-0.1c-0.3,0-0.5,0.2-0.5,0.4v0.6v0.1v4.3c-0.6,0.5-0.9,0.1-0.9,0.1l-0.7-1.5l-0.1-0.4c-0.1-0.2-0.4-0.3-0.7-0.3l-0.1,0c-0.3,0.1-0.5,0.3-0.4,0.5l0.2,0.6c0,0.1,0.1,0.1,0.1,0.2l0.8,1.8c0,0,0.9,4.3,5,4.1c4-0.2,4.2-3.9,4.2-3.9V4.6V4.6V4C47.3,3.8,47,3.6,46.7,3.6"></path>

    <path d="M38.9,34.8c0,0,3-4.6,7.7-7.1V13.8h-7.7V34.8z"></path>

    <path d="M83.5,41.3h7.6c0,0-2.2-15.9-26.3-16.6c-23.7,0.4-25.9,16.6-25.9,16.6h7.7c0,0,2.1-10.4,19-11.1C80.6,30.8,83.5,41.3,83.5,41.3"></path>

    <path d="M65,43.4h26.1v18.8h-7.3v-5.3c0,0-8.9,5.9-18.8,5.3c-10.1,0-25.2-5.3-26.1-18.8h7.7c0,0-1.1,13.1,19.1,13.4c14.1-0.6,16.6-8,16.6-8H65V43.4z"></path>

  </g>
</svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">INNOVATIVE</span>
        <span class="brand-sub" aria-label="Gloves Co., Ltd.">
          {"GLOVES CO.,LTD.".split("").map((ch) => <span aria-hidden="true">{ch === " " ? " " : ch}</span>)}
        </span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-list">
        {nav.map((group) => (
          <li class="nav-item">
            <a href={group.href} class="nav-top">
              {group.label}
              {group.children && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {group.children && (
              <div class="dropdown">
                <ul>
                  {group.children.map((c) => (
                    <li><a href={c.href} target={c.href.endsWith(".pdf") ? "_blank" : undefined} rel={c.href.endsWith(".pdf") ? "noopener" : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/contact" class="btn btn--ghost-green btn--sm">Contact</a>
    </div>

    <button class="burger" aria-label="Open menu" aria-expanded="false" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    <nav class="mm-nav" aria-label="Mobile">
      {nav.map((group) => (
        group.children ? (
          <details class="mm-group">
            <summary>{group.label}<span class="mm-caret" aria-hidden="true">▾</span></summary>
            <ul class="mm-sub">
              {group.children.map((c) => (<li><a href={c.href} target={c.href.endsWith(".pdf") ? "_blank" : undefined} rel={c.href.endsWith(".pdf") ? "noopener" : undefined}>{c.label}</a></li>))}
            </ul>
          </details>
        ) : (
          <a class="mm-link" href={group.href}>{group.label}</a>
        )
      ))}
    </nav>
    <div class="mm-cta">
      <a href="/contact" class="btn btn--primary">Contact</a>
      <a href="/request-samples" class="btn btn--ghost">Request Samples</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner { display: flex; align-items: center; gap: 20px; min-height: 76px; }

  .brand { display: flex; flex-direction: row; align-items: flex-end; gap: 2px; margin-right: auto; flex: none; }
  .brand-mark { color: var(--ink); height: 60px; display: flex; align-items: center; flex: none; }
  .brand-mark svg { height: 100%; width: auto; display: block; }
  .brand-text { display: flex; flex-direction: column; line-height: 0.9; }
  .brand-name { font-family: var(--font-head); font-weight: 900; font-size: 1.75rem; letter-spacing: 0.02em; color: var(--ink); }
  .brand-sub { font-family: var(--font-head); font-weight: 800; font-size: 1rem; letter-spacing: 0.25em; color: var(--green); margin-top: 1px; }

  .nav-list { display: flex; gap: clamp(6px, 0.9vw, 16px); }
  .nav-item { position: relative; }
  .nav-top {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase;
    color: var(--text-muted); white-space: nowrap; padding: 28px 0;
    transition: color 0.15s ease;
  }
  .nav-item:hover .nav-top, .nav-item:focus-within .nav-top { color: var(--ink); }
  .caret { font-size: 0.6rem; opacity: 0.6; }

  .dropdown {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(6px);
    min-width: 220px; background: #fff; border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: 0 16px 40px rgba(0,0,0,0.12);
    padding: 8px; opacity: 0; visibility: hidden; transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .nav-item:hover .dropdown, .nav-item:focus-within .dropdown {
    opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0);
  }
  .dropdown a {
    display: block; padding: 9px 12px; border-radius: 3px;
    font-size: 0.82rem; font-weight: 500; color: var(--text); white-space: nowrap;
  }
  .dropdown a:hover { background: var(--bg-2); color: var(--green-dark); }

  .header-actions { display: flex; align-items: center; gap: 16px; }
  .btn--sm { padding: 0.65em 1.1em; font-size: 0.72rem; }

  .burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; padding: 6px; cursor: pointer; }
  .burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
  .burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger.is-open span:nth-child(2) { opacity: 0; }
  .burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { display: none; }
  .mm-group { border-bottom: 1px solid var(--border); }
  .mm-group summary { display: flex; align-items: center; justify-content: space-between; cursor: pointer; list-style: none; padding: 15px 2px; font-family: var(--font-head); font-weight: 800; font-size: 0.95rem; letter-spacing: 0.02em; text-transform: uppercase; color: var(--ink); }
  .mm-group summary::-webkit-details-marker { display: none; }
  .mm-caret { font-size: 0.7rem; color: var(--text-muted); transition: transform 0.2s ease; }
  .mm-group[open] .mm-caret { transform: rotate(180deg); }
  .mm-sub { list-style: none; padding: 0 0 10px; margin: 0; display: grid; gap: 2px; }
  .mm-sub a { display: block; padding: 9px 12px; border-radius: var(--radius); font-size: 0.9rem; color: var(--text-muted); }
  .mm-sub a:hover { background: var(--bg-2); color: var(--green-dark); }
  .mm-link { display: block; border-bottom: 1px solid var(--border); padding: 15px 2px; font-family: var(--font-head); font-weight: 800; text-transform: uppercase; font-size: 0.95rem; color: var(--ink); }
  .mm-cta { display: grid; gap: 12px; margin-top: 22px; }
  .mm-cta .btn { width: 100%; justify-content: center; }

  @media (max-width: 1180px) {
    .nav, .header-actions { display: none; }
    .burger { display: flex; }
    .mobile-menu {
      display: block; position: fixed; left: 0; right: 0; top: 76px; bottom: 0;
      background: #fff; border-top: 1px solid var(--border);
      overflow-y: auto; padding: 8px 20px 48px; z-index: 99;
    }
    .mobile-menu[hidden] { display: none; }
  }
</style>

<script>
  const burger = document.getElementById("burger");
  const menu = document.getElementById("mobileMenu");
  if (burger && menu) {
    const setOpen = (open: boolean) => {
      menu.toggleAttribute("hidden", !open);
      burger.classList.toggle("is-open", open);
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.documentElement.style.overflow = open ? "hidden" : "";
    };
    burger.addEventListener("click", () => setOpen(menu.hasAttribute("hidden")));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
    window.addEventListener("resize", () => { if (window.innerWidth > 1180) setOpen(false); });
  }
</script>
