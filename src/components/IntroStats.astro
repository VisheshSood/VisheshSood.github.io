---
const stats = [
  { num: "25", label: "Years of Manufacturing" },
  { num: "14", label: "Production Lines, 24/7" },
  { num: "60+", label: "Glove Variations" },
  { num: "4", label: "Invented & Patented Grips" },
  { num: "12", label: "Industries Served" },
  { num: "Global", label: "Export Markets" },
];
---

<section class="section intro">
  <div class="container intro-grid">
    <div class="intro-copy">
      <p class="eyebrow">Since 2001 · Made in Thailand</p>
      <h2>More Than a<br />Glove Manufacturer<span class="dot">.</span></h2>
      <p class="intro-lede muted">
        Most companies sell gloves. We engineer them. Innovative Gloves is a
        family-owned, innovation-led manufacturer of patented grip technologies,
        backed by a complete range of more than 60 glove variations. One partner,
        from everyday disposables to highly differentiated specialist products.
      </p>
      <div class="intro-cta">
        <a href="/why-innovative" class="btn btn--primary">Why Innovative <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/gloves" class="btn btn--ghost">View All Gloves</a>
      </div>
    </div>

    <ul class="intro-stats">
      {stats.map((s) => (
        <li class="intro-stat">
          <span class="is-num">{s.num}</span>
          <span class="is-label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro { background: var(--bg); }
  .intro-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .intro-copy h2 { font-size: clamp(1.8rem, 3.6vw, 2.8rem); margin: 12px 0 20px; }
  .intro-lede { font-size: 1.05rem; margin-bottom: 28px; max-width: 52ch; }
  .intro-cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .intro-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .intro-stat { background: var(--bg); padding: 26px 22px; display: flex; flex-direction: column; gap: 4px; }
  .is-num { font-family: var(--font-head); font-weight: 800; font-size: clamp(2rem, 4vw, 2.8rem); color: var(--green-dark); line-height: 1; }
  .is-label { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }

  @media (max-width: 820px) { .intro-grid { grid-template-columns: 1fr; } }
</style>
