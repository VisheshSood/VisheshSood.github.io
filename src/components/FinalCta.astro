<section class="final-cta">
  <div class="container fc-inner">
    <p class="eyebrow">Try Them Yourself</p>
    <h2>Feel the Difference<span class="dot">.</span></h2>
    <p class="fc-lede">
      The fastest way to understand our grip technologies is to hold them.
      Request samples and put Innovative Gloves to work.
    </p>
    <div class="fc-cta">
      <a href="/request-samples" class="btn btn--primary">Request Samples <span class="arrow" aria-hidden="true">&rarr;</span></a>
      <a href="/contact" class="btn btn--ghost">Contact Us</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background:
      radial-gradient(120% 120% at 50% 0%, rgba(140,198,63,0.12), rgba(140,198,63,0) 60%),
      var(--bg);
    border-top: 1px solid var(--border);
  }
  .fc-inner { text-align: center; padding-block: clamp(64px, 9vw, 112px); max-width: 640px; }
  .fc-inner { margin-inline: auto; }
  .fc-inner h2 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 12px 0 18px; }
  .fc-lede { color: var(--text-muted); font-size: 1.08rem; margin-bottom: 30px; }
  .fc-cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; }
</style>
