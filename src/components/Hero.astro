---
// Hero, full-bleed image (right), copy (left), matching the mockup treatment.
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <!-- SEO: the page's H1 is the descriptive line; the brand headline below keeps its look as a styled <p>. -->
      <h1 class="hero-years">Nitrile &amp; Latex Glove Manufacturer in Thailand</h1>
      <p class="hero-title">
        25 Years of<br />
        Engineering<br />
        Better Protection<span class="dot">.</span>
      </p>
      <p class="hero-lede">
        From patented grip technologies to specialist heavy-duty gloves, we
        develop solutions designed to perform where ordinary disposable gloves
        fall short.
      </p>
      <div class="hero-cta">
        <a href="/technologies" class="btn btn--primary">
          Explore Our Technologies <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/gloves" class="btn btn--ghost">
          Find Your Glove <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <a href="/3d" class="hero-3d">
        <span class="hero-3d-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/></svg></span>
        Spin a Glove in 3D <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="hero-media">
      <img class="hero-img" src="/images/hero-glove-wrench.jpg" alt="Green textured nitrile glove gripping a wrench in a workshop" width="1122" height="1402" />
      <div class="hero-badge" aria-hidden="true">
        <span class="hero-badge-num">25</span>
        <span class="hero-badge-yrs">Years</span>
        <span class="hero-badge-txt">of Innovation</span>
        <span class="hero-badge-since">Since 2001</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: min(76vh, 700px);
  }

  /* Left copy, aligned to the site container's left edge, roomy on the right */
  .hero-copy {
    padding-block: clamp(40px, 6vw, 80px);
    padding-left: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    padding-right: clamp(28px, 4vw, 64px);
    position: relative;
    z-index: 2;
  }
  .hero-years {
    font-family: var(--font-body);
    line-height: 1.5;
    color: var(--green-dark);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-size: 0.82rem;
    margin-bottom: 18px;
  }
  @media (max-width: 600px) { .hero-years { letter-spacing: 0.14em; font-size: 0.74rem; } }
  .hero .hero-title {
    font-family: var(--font-head);
    text-transform: uppercase;
    color: var(--ink);
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 0.95;
    margin-bottom: 26px;
  }
  .hero-lede {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 42ch;
    margin-bottom: 34px;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-3d { display: inline-flex; align-items: center; gap: 10px; margin-top: 18px; padding: 10px 18px 10px 10px; border-radius: 999px; background: var(--ink); color: #fff; font: 600 14px/1 var(--font-body); letter-spacing: .02em; text-decoration: none; transition: transform .2s ease, background .2s ease; }
  .hero-3d:hover { background: #000; transform: translateY(-1px); }
  .hero-3d:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .hero-3d-ic { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--green); color: var(--ink); }
  .hero-3d-ic svg { animation: hero3dSpin 6s linear infinite; }
  @keyframes hero3dSpin { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hero-3d-ic svg { animation: none; } }

  /* Right media, full-bleed to top/bottom/right, soft fade into bg on the left */
  .hero-media { position: relative; align-self: stretch; min-height: 320px; }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
    display: block;
  }
  .hero-media::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to right, var(--bg) 0%, rgba(255,255,255,0) 24%);
    pointer-events: none;
  }
  .hero-badge {
    position: absolute;
    right: clamp(18px, 3vw, 40px);
    bottom: clamp(18px, 3vw, 36px);
    z-index: 2;
    display: grid;
    justify-items: end;
    text-align: right;
    line-height: 1;
    font-family: var(--font-head);
    text-shadow: 0 1px 10px rgba(0,0,0,0.55);
  }
  .hero-badge-num { font-size: 2.8rem; font-weight: 900; color: #fff; }
  .hero-badge-yrs { font-size: 0.95rem; letter-spacing: 0.2em; color: #fff; }
  .hero-badge-txt { font-size: 0.72rem; letter-spacing: 0.24em; color: #fff; margin-top: 4px; }
  .hero-badge-since { font-size: 0.62rem; letter-spacing: 0.2em; color: var(--green); margin-top: 6px; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy {
      padding-inline: var(--gutter);
      order: 2;
    }
    .hero-media { order: 1; min-height: 46vh; }
    .hero-media::before { background: linear-gradient(to top, var(--bg) 0%, rgba(255,255,255,0) 30%); }
  }
</style>
